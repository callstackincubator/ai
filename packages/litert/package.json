{
  "name": "@react-native-ai/litert",
  "version": "0.12.0",
  "description": "LiteRT-LM provider for Vercel AI SDK",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "license": "MIT",
  "homepage": "https://github.com/callstackincubator/ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callstackincubator/ai.git"
  },
  "bugs": {
    "url": "https://github.com/callstackincubator/ai/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "del-cli lib",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepare": "bob build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.33"
  },
  "peerDependencies": {
    "react-native": ">=0.76.0",
    "react-native-litert-lm": ">=0.8.2"
  },
  "devDependencies": {
    "ai": "^7.0.0",
    "react-native": "0.88.0",
    "react-native-litert-lm": "0.8.2",
    "zod": "^4.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "keywords": [
    "react-native",
    "litert",
    "litert-lm",
    "llm",
    "on-device",
    "ai",
    "sdk",
    "vercel"
  ]
}
